{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lukashala",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/u/*", "/admin"]
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "3c5938c36cf24681a871117a26fd7ea5" }
  ],
  "observability": { "enabled": true }
}
